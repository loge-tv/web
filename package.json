{
  "name": "skiptv-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b && eslint .",
    "build:fake": "vite build --mode fake --outDir dev/.out/dist --emptyOutDir",
    "dev:fake": "vite --mode fake",
    "fake": "node dev/fake-server.mjs",
    "smoke": "node dev/smoke.mjs",
    "screens": "playwright test -c dev/screens",
    "screens:update": "playwright test -c dev/screens --update-snapshots"
  },
  "dependencies": {
    "hls.js": "1.7.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  }
}
